---
import type { Keyword } from "@graviola/core"
import { rarityBoxShadow } from "../../utils/rarity"

interface Props {
    keyword: Keyword
}

const {
    keyword: { name, rarity },
} = Astro.props
---

<div
    class:list={[
        "rounded-xl text-base px-3 py-2 dark:bg-dark-border bg-light-border",
        "shadow-md hover:bg-stone-500 dark:hover:bg-dark-stone-900",
        rarityBoxShadow[rarity],
    ]}
>
    {name}
</div>
