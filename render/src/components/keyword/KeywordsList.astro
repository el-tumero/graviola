---
import { getKeywords } from "../../web3"
import Keyword from "./Keyword.astro"
import Tooltip from "../common/tooltip/Tooltip.astro"
import camelToPascal from "../../utils/camelToPascal"
import { rarityTextColor } from "../../utils/rarity"

const keywords = (await getKeywords()).reverse()
---

<div class="flex flex-wrap gap-4 justify-center">
    {
        keywords.map((keyword) => (
            <Tooltip>
                <span slot="text">
                    Rarity:&nbsp;
                    <span class={rarityTextColor[keyword.rarity]}>
                        {camelToPascal(keyword.rarity)}
                    </span>
                </span>
                <Keyword slot="element" keyword={keyword} />
            </Tooltip>
        ))
    }
</div>
