---
import { rarityToTextColor, shortenCardId, type Card } from "@graviola/core"
import camelToPascal from "../../utils/camelToPascal"
import { rarityTextColor } from "../../utils/rarity"
import TooltipCopy from "../common/tooltip/TooltipCopy.astro"

interface Props {
    card: Card
}

const { card } = Astro.props
---

<div
    class:list={[
        "flex flex-col w-full h-fit gap-1",
        "justify-start items-start",
        "pt-2",
    ]}
>
    <TooltipCopy copyText={card.id}>
        <span slot="root">
            <p>id: {shortenCardId(card.id)}</p>
        </span>
        <div slot="text">
            <p class="card-id">{card.id}</p>
        </div>
    </TooltipCopy>
    <p>
        Rarity:&nbsp;<span class={rarityTextColor[card.rarity]}
            >{camelToPascal(card.rarity, true)}</span
        >
    </p>
</div>
<div
    class:list={[
        "flex flex-wrap w-full h-fit",
        "gap-1 justify-start items-start",
        "mt-auto",
    ]}
>
    {
        card.keywords.map((keyword) => (
            <span
                class:list={[
                    "py-1 px-2 rounded-md",
                    "bg-light-bgLight/75 dark:bg-dark-bgLight/75",
                    rarityToTextColor(keyword.rarity),
                ]}
            >
                {keyword.name}
            </span>
        ))
    }
</div>
