---
import logo from "../../assets/logo.webp"
---

<a
    class:list={[
        "flex",
        "items-center",
        "gap-1",
        "w-fit rounded-xl",
        "p-2",
        "hover:bg-accent/25 transition-colors duration-300",
    ]}
    href="/"
>
    <img src={logo.src} width="16" class="mb-1" />
    <p
        class:list={[
            "font-semibold font-mono text-accentDark dark:text-accent opacity-100",
            "leading-none",
        ]}
    >
        Graviola
    </p>
</a>
