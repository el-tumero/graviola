---
interface Props {
    copyText: string
}

const { copyText } = Astro.props
---

<div class="relative inline-block group">
    <clipboard-element data-text={copyText}>
        <slot name="root" />
        <div
            class="absolute left-1/2 transform -translate-x-1/2 -top-10
                bg-dark-bgDark text-white text-xs px-3 py-2 rounded-lg shadow-lg
                transition-opacity duration-300 opacity-0 group-hover:opacity-100
                pointer-events-none whitespace-nowrap text-center"
        >
            <p class="copy-info">Copy to clipboard:</p>
            <slot name="text" />
        </div>
    </clipboard-element>
</div>

<script>
    const defaultCopyText = "Copy to clipboard:"
    const afterCopyText = "Copied!"

    class ClipboardElement extends HTMLElement {
        connectedCallback() {
            const copyText = this.dataset.text
            const copyInfo = this.querySelector(".copy-info")
            if (!copyInfo || !copyText) return

            this.addEventListener("click", () => {
                navigator.clipboard.writeText(copyText)
                copyInfo.textContent = afterCopyText
                setTimeout(() => {
                    copyInfo.textContent = defaultCopyText
                }, 1000)
            })
        }
    }
    customElements.define("clipboard-element", ClipboardElement)
</script>
